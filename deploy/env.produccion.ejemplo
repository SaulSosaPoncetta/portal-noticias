# =====================================================================
# .env de PRODUCCIÓN - Portal de Noticias
# En el VPS: copiar como /var/www/portal-noticias/.env y completar
# los valores marcados con <<< >>>
# =====================================================================

APP_NAME="Ocio Digital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ociodigital.com.ar
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portal_noticias
DB_USERNAME=portal_noticias
DB_PASSWORD=<<<CONTRASEÑA_DE_MYSQL>>>

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=ociodigital.com.ar
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="redaccion@ociodigital.com.ar"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
